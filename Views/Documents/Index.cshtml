@model IEnumerable<NardzSAO.Models.Document>
@{
    ViewData["Title"] = "Documents";
}

<div class="container-lg py-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <div>
            <h1>Documents</h1>
            <p class="text-muted mb-0">Manage uploaded supporting files and student records securely.</p>
        </div>
        <a asp-action="Upload" class="btn btn-primary">Upload Document</a>
    </div>

    <div class="table-card">
        <table class="table mb-0">
            <thead>
                <tr>
                    <th>File Name</th>
                    <th>Category</th>
                    <th>Size</th>
                    <th>Uploaded</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var doc in Model)
                {
                    <tr>
                        <td>@doc.FileName</td>
                        <td>@doc.Category</td>
                        <td>@((doc.FileSize / 1024.0).ToString("0.##")) KB</td>
                        <td>@doc.CreatedAt.ToString("MMM dd, yyyy")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
