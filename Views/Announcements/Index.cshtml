@model IEnumerable<NardzSAO.Models.Announcement>
@{
    ViewData["Title"] = "Announcements";
}

<div class="container-lg py-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-3">
        <div>
            <h1>Announcements</h1>
            <p class="text-muted mb-0">Stay informed with campus updates and student affairs notices.</p>
        </div>
        @if (User.IsInRole("Staff") || User.IsInRole("Admin"))
        {
            <a class="btn btn-primary" asp-action="Create">Create Announcement</a>
        }
    </div>

    <form method="get" class="panel-card p-3 mb-4">
        <div class="row g-3">
            <div class="col-md-4"><input name="search" class="form-control" placeholder="Search title or content" /></div>
            <div class="col-md-3">
                <select name="category" class="form-select">
                    <option value="">All categories</option>
                    @foreach (var category in Enum.GetValues<NardzSAO.Models.AnnouncementCategoryType>())
                    {
                        <option value="@category">@category</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <select name="priority" class="form-select">
                    <option value="">All priorities</option>
                    @foreach (var priority in Enum.GetValues<NardzSAO.Models.AnnouncementPriority>())
                    {
                        <option value="@priority">@priority</option>
                    }
                </select>
            </div>
            <div class="col-md-2"><button type="submit" class="btn btn-primary w-100">Filter</button></div>
        </div>
    </form>

    @if (!Model.Any())
    {
        <div class="empty-state panel-card">No announcements found.</div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var announcement in Model)
            {
                <div class="col-lg-6">
                    <div class="card-soft h-100">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge bg-warning text-dark">@announcement.Priority</span>
                            <small class="text-muted">@announcement.PublishDate.ToString("MMM dd, yyyy")</small>
                        </div>
                        <h3>@announcement.Title</h3>
                        <p class="text-muted">@announcement.Content</p>
                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <span class="badge text-bg-light">@announcement.Category</span>
                            <a asp-action="Details" asp-route-id="@announcement.Id" class="btn btn-outline-primary btn-sm">Read more</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
