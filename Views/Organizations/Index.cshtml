@model IEnumerable<NardzSAO.Models.Organization>
@{
    ViewData["Title"] = "Organizations";
}

<div class="container-lg py-4">
    <div class="page-header">
        <h1>Student Organizations</h1>
        <p class="text-muted">Browse and connect with active student groups on campus.</p>
    </div>

    <div class="row g-4">
        @foreach (var org in Model)
        {
            <div class="col-md-6 col-xl-4">
                <div class="card-soft h-100">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <strong>@org.Name</strong>
                        <span class="badge text-bg-light">@org.Category</span>
                    </div>
                    <p class="text-muted">@org.Description</p>
                    <div class="small text-muted">President: @org.President</div>
                    <div class="small text-muted">Adviser: @org.Adviser</div>
                    <div class="mt-3">
                        <a asp-action="Details" asp-route-id="@org.Id" class="btn btn-outline-primary btn-sm">View</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
