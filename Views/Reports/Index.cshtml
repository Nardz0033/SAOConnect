@model dynamic
@{
    ViewData["Title"] = "Reports";
}

<div class="container-lg py-4">
    <div class="page-header">
        <h1>SAO Reports</h1>
        <p class="text-muted">Generate quick views of attendance, requests, organizations, and engagement.</p>
    </div>

    <div class="row g-4">
        <div class="col-md-3"><div class="metric-card"><span class="value">@Model.TotalAttendances</span><div class="label">Attendance</div></div></div>
        <div class="col-md-3"><div class="metric-card"><span class="value">@Model.TotalRequests</span><div class="label">Requests</div></div></div>
        <div class="col-md-3"><div class="metric-card"><span class="value">@Model.TotalOrganizations</span><div class="label">Organization Memberships</div></div></div>
        <div class="col-md-3"><div class="metric-card"><span class="value">@Model.TotalUsers</span><div class="label">Users</div></div></div>
    </div>

    <div class="panel-card p-4 mt-4">
        <button class="btn btn-primary" onclick="window.print()">Print Report</button>
    </div>
</div>
