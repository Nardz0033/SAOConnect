@model IEnumerable<NardzSAO.Models.Appointment>
@{
    ViewData["Title"] = "Appointments";
}

<div class="container-lg py-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <div>
            <h1>Appointments</h1>
            <p class="text-muted mb-0">Schedule and manage student affairs appointments.</p>
        </div>
        @if (User.IsInRole("Student"))
        {
            <a class="btn btn-primary" asp-action="Create">Request Appointment</a>
        }
    </div>

    <div class="table-card">
        <table class="table mb-0">
            <thead>
                <tr>
                    <th>Type</th>
                    <th>Date</th>
                    <th>Time</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var appt in Model)
                {
                    <tr>
                        <td>@appt.AppointmentType</td>
                        <td>@appt.PreferredDate.ToString("MMM dd, yyyy")</td>
                        <td>@appt.PreferredTime</td>
                        <td><span class="badge badge-status badge-@appt.Status.ToString().ToLowerInvariant()">@appt.Status</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
