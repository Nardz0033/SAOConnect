@model NardzSAO.Models.Appointment
@{
    ViewData["Title"] = "Request Appointment";
}

<div class="container-lg py-4">
    <div class="panel-card p-4 form-card">
        <h1>Request an Appointment</h1>
        <form asp-action="Create" method="post">
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="AppointmentType" class="form-label"></label>
                    <input asp-for="AppointmentType" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="PreferredDate" class="form-label"></label>
                    <input asp-for="PreferredDate" type="date" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="PreferredTime" class="form-label"></label>
                    <input asp-for="PreferredTime" class="form-control" />
                </div>
                <div class="col-12">
                    <label asp-for="Reason" class="form-label"></label>
                    <textarea asp-for="Reason" class="form-control"></textarea>
                </div>
                <div class="col-12 d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary">Submit</button>
                </div>
            </div>
        </form>
    </div>
</div>
