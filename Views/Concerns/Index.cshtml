@model IEnumerable<NardzSAO.Models.Concern>
@{
    ViewData["Title"] = "Concerns";
}

<div class="container-lg py-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <div>
            <h1>Student Concerns</h1>
            <p class="text-muted mb-0">Track submitted feedback and concerns securely.</p>
        </div>
        @if (User.IsInRole("Student"))
        {
            <a asp-action="Create" class="btn btn-primary">Submit Concern</a>
        }
    </div>

    <div class="table-card">
        <table class="table mb-0">
            <thead>
                <tr>
                    <th>Category</th>
                    <th>Description</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var concern in Model)
                {
                    <tr>
                        <td>@concern.Category</td>
                        <td>@concern.Description</td>
                        <td><span class="badge badge-status badge-@concern.Status.ToString().ToLowerInvariant()">@concern.Status</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
