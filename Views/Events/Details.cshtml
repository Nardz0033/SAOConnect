@model NardzSAO.Models.Event
@{
    ViewData["Title"] = Model.Name;
    var isRegistered = ViewBag.IsRegistered as bool? ?? false;
}

<div class="container-lg py-4">
    <div class="panel-card p-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
            <span class="badge bg-primary-subtle text-primary">@Model.Category</span>
            <small class="text-muted">Registration deadline: @Model.RegistrationDeadline.ToString("MMM dd, yyyy")</small>
        </div>
        <h1>@Model.Name</h1>
        <p class="text-muted">@Model.Location • @Model.StartDateTime.ToString("MMM dd, yyyy") • @Model.StartDateTime.ToString("hh:mm tt") - @Model.EndDateTime.ToString("hh:mm tt")</p>
        <p>@Model.Description</p>

        @if (User.IsInRole("Student"))
        {
            if (isRegistered)
            {
                <span class="badge badge-status badge-approved">Registered</span>
            }
            else
            {
                <form asp-action="Register" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="btn btn-primary">Register</button>
                </form>
            }
        }

        @if (User.IsInRole("Staff") || User.IsInRole("Admin"))
        {
            <a asp-action="Attendance" asp-route-id="@Model.Id" class="btn btn-outline-primary mt-3">Attendance Dashboard</a>
        }
    </div>
</div>
