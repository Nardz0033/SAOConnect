@{
    ViewData["Title"] = "Event Attendance";
    var eventItem = ViewData["Event"] as NardzSAO.Models.Event;
    var qrValue = ViewBag.QrValue?.ToString() ?? string.Empty;
}

<div class="container-lg py-4">
    @if (eventItem == null)
    {
        <div class="empty-state panel-card">Event information is not available.</div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-lg-5">
                <div class="panel-card p-4">
                    <h2>@eventItem.Name</h2>
                    <p class="text-muted">@eventItem.Location</p>
                    <img src="https://api.qrserver.com/v1/create-qr-code/?size=220x220&data=@Uri.EscapeDataString(qrValue)" class="img-fluid" alt="QR Attendance" />
                    <p class="mt-3 mb-0">Scan code to mark attendance.</p>
                </div>
            </div>
            <div class="col-lg-7">
                <div class="panel-card p-4">
                    <h3>Attendance Summary</h3>
                    <div class="row g-3 mt-2">
                        <div class="col-md-4"><div class="card-soft"><strong>@ViewBag.RegisteredCount</strong><div class="text-muted">Registered</div></div></div>
                        <div class="col-md-4"><div class="card-soft"><strong>@ViewBag.PresentCount</strong><div class="text-muted">Present</div></div></div>
                        <div class="col-md-4"><div class="card-soft"><strong>@ViewBag.AbsentCount</strong><div class="text-muted">Absent</div></div></div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
